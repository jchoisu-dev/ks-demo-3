# Copy to .env and fill in. Never commit .env.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Oregon Lottery API subscription key (used by src/scrapers/oregon-keno.js)
OREGON_API_KEY=
# Set to true for ElastiCache with in-transit encryption (required when using an AUTH token)
REDIS_TLS=false
